# Environment configuration — SYNTHETIC EXAMPLE ONLY
#
# Copy to `.env` only if you need the repository QA / evidence sanitization
# tools. Every value below is a DUMMY. Never place real credentials, real
# client hostnames you are not authorized to reference, real filesystem
# paths containing client data, or any secret in this file.
#
# `.env` is excluded by .gitignore. This example file IS committed.
#
# NOTE: No script in this repository reads credentials or contacts the client
# target. These variables exist only so that the local QA tooling has a
# single, auditable configuration surface.

# ---------------------------------------------------------------------------
# Repository QA (scripts/repo_checks.py)
# ---------------------------------------------------------------------------

# Root directory to validate. Relative paths resolve from the repository root.
NW_REPO_ROOT=.

# Comma-separated file extensions treated as Markdown for link checking.
NW_MARKDOWN_EXTS=.md,.markdown

# Set to "true" to treat broken relative links as a hard failure.
NW_FAIL_ON_BROKEN_LINKS=true

# Set to "true" to print a JSON report to stdout.
NW_JSON_REPORT=false

# ---------------------------------------------------------------------------
# Evidence sanitization (scripts/evidence_sanitizer.py)
# ---------------------------------------------------------------------------

# Default output directory for sanitized copies. Overwritten output is NEVER
# written back to the input path by the tool.
NW_SANITIZER_OUTPUT_DIR=./sanitized-out

# Set to "true" to emit a machine-readable JSON summary alongside the copy.
NW_SANITIZER_JSON_REPORT=false

# Maximum number of redaction hits reported per pattern class (not per match
# value). Matched secrets are never printed in full.
NW_SANITIZER_MAX_HITS_PER_CLASS=5

# ---------------------------------------------------------------------------
# Non-sensitive engagement identifiers (safe to keep in plaintext)
# ---------------------------------------------------------------------------

NW_ENGAGEMENT_ID=NW-B083
NW_BATCH=B083
NW_MILESTONE=DEFAULT
NW_EVIDENCE_PREFIX=NW-B083

# ---------------------------------------------------------------------------
# DELIBERATELY ABSENT
# ---------------------------------------------------------------------------
# There is intentionally no variable here for:
#   - target hostnames or IPs
#   - usernames or passwords
#   - API keys, tokens, cookies, session identifiers
#   - paths to the off-repository raw evidence store
#   - client contact details
# Keep it that way. Configuration is not an appropriate place for engagement
# secrets, and a repository that needs no secret configuration is easier to
# audit.
